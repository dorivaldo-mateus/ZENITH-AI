<script src="https://cdn.jsdelivr.net/particles.js/2.0.0/particles.min.js"></script>
<script type="module">
  import{validarEmail} from "./ai.js"


  document.getElementById("in").addEventListener("click", function(){
    document.querySelector(".login").classList.toggle("log")
    document.querySelector("body").classList.toggle("fundo")
  })
  
  const frase = "Aprenda qualquer disciplina com explicações claras e personalizadas com a ZENITH";
  const elemento = document.getElementById("texto");
let i = 0;

function digitar() {
    if (i < frase.length) {
        elemento.textContent += frase.charAt(i);
        i++;
        setTimeout(digitar, 40);
    }
}
digitar();

  document.getElementById('form').addEventListener('submit', async (e)=>{
    e.preventDefault()
    const nome = document.querySelector("#name").value;
const email = document.querySelector("#email").value;
const senha = document.querySelector("#pass").value;
const confirmar = document.querySelector("#confirm").value;

if (nome === "") {
  alert("Digite o nome");
  return;
}

if (!email.includes("@")) {
  alert("Email inválido");
  return;
}

if (senha.length < 8) {
  alert("A senha deve ter pelo menos 8 caracteres");
  return;
}

if (senha !== confirmar) {
  alert("As palavras-passe não coincidem");
  return;
}

const validado = await validarEmail(email)
const valido = validado.email_deliverability
.status_detail == "valid_email";
console.log(valido)
fetch("http://localhost:5000/users", {
  method: "POST",
  headers: {
    "Content-Type": "application/json"
  },
  body: JSON.stringify({
    nome: nome,
    email: email,
    password: senha
 })
});

document.querySelector(".login").classList.remove("log")
document.getElementById("in").textContent="Sair"
var ids = document.getElementById("in")
ids.style.dispay="none"
var new_id = document.createElement("button")
new_id.innerHTML="Terminar Sessão"
new_id.classList.add("new_btn")
var header = document.querySelector("header")
header.appendChild(new_id)
header.removeChild(ids)

document.getElementById("out").addEventListenner("click", function(){
  alert("WSdvb")
})
function end(){

}
const saud = document.querySelector(".saud")
saud.innerHTML = `Bem Vindo A ZENITH ${nome} <br><br> <span>Começa aqui a sua jornada de crescimento</span>`
document.querySelector(".close_modal").classList.toggle("bazar")

})

document.querySelector(".close_modal").addEventListener("click", function (){
  document.getElementById("modal").classList.toggle("bazar")
})

