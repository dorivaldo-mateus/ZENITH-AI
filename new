    document.getElementById("criar").style.display="none"
    document.getElementById("iniciar").style.display="block"
    
  })

  
  particlesJS("particles-js", {
  particles: {
    number: {
      value: 400
    },

    color: {
      value: "#5c82ff"
    },

    shape: {
      type: "circle"
    },

    opacity: {
      value: 0.4
    },

    size: {
      value: 2
    },

    move: {
      enable: true,
      speed: 1        
    },
    line_linked: {
      enable: true,
      distance: 150,
      color: "#700e88",
      opacity: 0.2,
      width: 1
    }
  },

  interactivity: {
    events: {
      onhover: {
        enable: true,
        mode: "grab"
      }
    }
  }
 });
